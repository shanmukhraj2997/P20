# Backend Configuration Example
# DJANGO_SECRET_KEY is mandatory when DEBUG=False in production
DJANGO_SECRET_KEY=your-secret-key-here-do-not-commit
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,172.25.176.1

# PostgreSQL Database Configuration
POSTGRES_DB=p20_campus_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Booking & Check-in Configuration
CHECKIN_GRACE_PERIOD_MINUTES=30

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email & Notification Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_email_password_or_app_token
DEFAULT_FROM_EMAIL=noreply@campus.edu

# Frontend Environment Variable (Next.js)
# Place in frontend/.env.local:
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
